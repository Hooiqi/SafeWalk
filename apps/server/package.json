{
  "name": "@safewalk/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "simulate-walk": "node --env-file-if-exists=.env scripts/simulate-walk.js"
  },
  "dependencies": {
    "@safewalk/shared": "0.1.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.15",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  }
}
