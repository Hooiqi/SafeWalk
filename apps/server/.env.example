# Copy to apps/server/.env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Supabase database connection string (Project Settings > Database).
# Use the DIRECT or SESSION pooler string (port 5432), not the transaction pooler.
# Local Supabase CLI: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_SSL=false

# Token verification. Set SUPABASE_URL (JWKS, current projects); set
# SUPABASE_JWT_SECRET only for projects/local stacks using the legacy HS256 secret
# (`supabase status` prints it as "JWT secret").
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_SECRET=

# Leave empty to allow any email domain during demos.
# The team's data contract says "only USM accounts": student.usm.my,usm.my
ALLOWED_USER_EMAIL_DOMAINS=

CORS_ORIGINS=http://localhost:5173,http://localhost:5174
TRACKING_PAGE_URL=http://localhost:5173/t/

# OSRM walking routes. The default is the FOSSGIS public foot-routing server
# (fair-use demo service). For production, self-host OSRM with the foot profile.
OSRM_BASE_URL=https://routing.openstreetmap.de/routed-foot
OSRM_PROFILE=foot

# Watchdog: node-cron schedule (with seconds) and the proposal's 3-minute grace period.
WATCHDOG_CRON=*/5 * * * * *
GRACE_PERIOD_SECONDS=180
HEARTBEAT_STALE_SECONDS=60
ETA_BUFFER_SECONDS=0
TRACKING_LINK_TTL_AFTER_END_MINUTES=30

# DEVELOPMENT ONLY: shorten every trip ETA to this many seconds so the grace
# prompt and escalation can be demonstrated without a long walk. Ignored when
# NODE_ENV=production. Leave empty for real walking ETAs.
DEV_ETA_OVERRIDE_SECONDS=

# --- Notification channels (optional; unset = reported as "skipped") ---
# Firebase service account JSON on one line (FCM push to the app user).
FIREBASE_SERVICE_ACCOUNT_JSON=
# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=
# SMTP, e.g. smtp://user:pass@smtp.example.com:587
SMTP_URL=
SMTP_FROM=SafeWalk <no-reply@safewalk.test>
